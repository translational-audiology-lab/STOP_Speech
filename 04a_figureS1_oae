# Function to create correlation plot using predetermined best-fit model
create_corr_plot <- function(df, x_col, y_col, y_label, best_model_type, best_r2, best_p) {
  
  # Prepare plot data
  plot_data <- df %>%
    select(all_of(c(x_col, y_col))) %>%
    filter(!is.na(.[[x_col]]), !is.na(.[[y_col]]),
           is.finite(.[[x_col]]), is.finite(.[[y_col]]))
  
  if (nrow(plot_data) < 3) {
    return(ggplot() + theme_void() +
             annotate("text", x = 0.5, y = 0.5, label = "Insufficient data", size = 4))
  }
  
  # Fit all models (for prediction)
  X_centered <- scale(plot_data[[x_col]], scale = FALSE)
  plot_data_poly <- plot_data
  plot_data_poly$X_centered <- as.numeric(X_centered)
  plot_data_poly$X2 <- plot_data_poly$X_centered^2
  plot_data_poly$X3 <- plot_data_poly$X_centered^3
  
  m_linear <- lm(as.formula(paste(y_col, "~ X_centered")), data = plot_data_poly)
  m_quad   <- lm(as.formula(paste(y_col, "~ X_centered + X2")), data = plot_data_poly)
  m_cubic  <- lm(as.formula(paste(y_col, "~ X_centered + X2 + X3")), data = plot_data_poly)
  
  # Select model and color based on LRT decision
  if (best_model_type == "Linear") {
    m_best <- m_linear
    line_color <- "#1f77b4"  # Blue
  } else if (best_model_type == "Quadratic") {
    m_best <- m_quad
    line_color <- "#ff7f0e"  # Orange
  } else {
    m_best <- m_cubic
    line_color <- "#d62728"  # Red
  }
  
  # Create predictions
  x_min <- min(plot_data[[x_col]])
  x_max <- max(plot_data[[x_col]])
  x_range <- seq(x_min, x_max, length.out = 200)
  
  if (best_model_type == "Linear") {
    X_center_range <- x_range - mean(plot_data[[x_col]])
    pred_df <- data.frame(X_centered = X_center_range)
    pred_fit <- predict(m_best, newdata = pred_df, se.fit = TRUE)
  } else if (best_model_type == "Quadratic") {
    X_center_range <- x_range - mean(plot_data[[x_col]])
    pred_df <- data.frame(X_centered = X_center_range, X2 = X_center_range^2)
    pred_fit <- predict(m_best, newdata = pred_df, se.fit = TRUE)
  } else {
    X_center_range <- x_range - mean(plot_data[[x_col]])
    pred_df <- data.frame(X_centered = X_center_range,
                          X2 = X_center_range^2,
                          X3 = X_center_range^3)
    pred_fit <- predict(m_best, newdata = pred_df, se.fit = TRUE)
  }
  
  fit_data <- data.frame(x = x_range, y = pred_fit$fit, se = pred_fit$se.fit)
  
  # Create plot
  p <- ggplot(plot_data, aes(x = .data[[x_col]], y = .data[[y_col]])) +
    geom_point(alpha = 0.4, size = 2.5, color = "gray40") +
    geom_line(data = fit_data, aes(x = x, y = y),
              color = line_color, size = 1.2, linetype = "solid") +
    geom_ribbon(data = fit_data, aes(x = x, ymin = y - 1.96*se, ymax = y + 1.96*se),
                alpha = 0.15, fill = line_color, inherit.aes = FALSE)
  
  # Format subtitle with model type
  p_text <- format_pvalue_scientific(best_p)
  
  subtitle_text <- bquote(italic(R)^2 ~ "=" ~ .(sprintf("%.3f", best_r2)) ~
                            ", " ~ italic(p) ~ "=" ~ .(p_text) ~
                            " (" ~ .(best_model_type) ~ ")")
  
  p <- p +
    scale_x_continuous(name = "OAE SNR (dB)") +
    scale_y_continuous(name = y_label) +
    theme_minimal() +
    theme(
      axis.title = element_text(size = 12, face = "plain", family = "Helvetica"),
      axis.text = element_text(size = 11, family = "Helvetica"),
      axis.ticks = element_blank(),
      panel.grid.major = element_line(color = "gray90", linewidth = 0.3),
      panel.grid.minor = element_blank(),
      plot.margin = unit(c(0.3, 0.3, 0.3, 0.3), "cm"),
      plot.subtitle = element_text(size = 11, hjust = 0.5, family = "Helvetica"),
      aspect.ratio = 1
    ) +
    labs(subtitle = subtitle_text)
  
  return(p)
}

