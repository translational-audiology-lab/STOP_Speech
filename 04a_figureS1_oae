# ==============================================================================
# Format p-values in scientific notation
# ==============================================================================

format_pvalue_scientific <- function(p_values) {
  sapply(p_values, function(p) {
    if (is.na(p) || !is.finite(p)) {
      return("NA")
    }
    return(sprintf("%.2e", p))
  })
}

# ==============================================================================
# Fit polynomial models and select best using AIC
# ==============================================================================

fit_polynomial_models_aic <- function(df, outcome_var, predictor_var) {
  
  model_data <- df %>%
    select(all_of(c(outcome_var, predictor_var))) %>%
    filter(!is.na(.[[outcome_var]]), !is.na(.[[predictor_var]]),
           is.finite(.[[outcome_var]]), is.finite(.[[predictor_var]]))
  
  if (nrow(model_data) < 10) {
    return(list(
      n = nrow(model_data),
      r2_linear = NA, r2_quadratic = NA, r2_cubic = NA,
      p_linear = NA, p_quadratic = NA, p_cubic = NA,
      aic_linear = NA, aic_quadratic = NA, aic_cubic = NA,
      best_model = "Insufficient data", best_r2 = NA, best_p = NA, best_aic = NA
    ))
  }
  
  X <- model_data[[predictor_var]]
  X_centered <- X - mean(X)
  model_data$X_centered <- X_centered
  model_data$X2 <- X_centered^2
  model_data$X3 <- X_centered^3
  
  m_linear <- lm(as.formula(paste(outcome_var, "~ X_centered")), data = model_data)
  m_quad <- lm(as.formula(paste(outcome_var, "~ X_centered + X2")), data = model_data)
  m_cubic <- lm(as.formula(paste(outcome_var, "~ X_centered + X2 + X3")), data = model_data)
  
  r2_linear <- summary(m_linear)$r.squared
  r2_quad <- summary(m_quad)$r.squared
  r2_cubic <- summary(m_cubic)$r.squared
  
  fstat_linear <- summary(m_linear)$fstatistic
  p_linear <- 1 - pf(fstat_linear[1], fstat_linear[2], fstat_linear[3])
  
  anova_quad <- anova(m_linear, m_quad)
  p_quad <- anova_quad$`Pr(>F)`[2]
  
  anova_cubic <- anova(m_quad, m_cubic)
  p_cubic <- anova_cubic$`Pr(>F)`[2]
  
  aic_linear <- AIC(m_linear)
  aic_quad <- AIC(m_quad)
  aic_cubic <- AIC(m_cubic)
  
  aic_values <- c(aic_linear, aic_quad, aic_cubic)
  model_names <- c("Linear", "Quadratic", "Cubic")
  best_idx <- which.min(aic_values)
  best_model <- model_names[best_idx]
  
  if (best_model == "Linear") {
    best_r2 <- r2_linear
    best_p <- p_linear
    best_aic <- aic_linear
  } else if (best_model == "Quadratic") {
    best_r2 <- r2_quad
    best_p <- p_quad
    best_aic <- aic_quad
  } else {
    best_r2 <- r2_cubic
    best_p <- p_cubic
    best_aic <- aic_cubic
  }
  
  return(list(
    n = nrow(model_data),
    r2_linear = r2_linear,
    r2_quadratic = r2_quad,
    r2_cubic = r2_cubic,
    p_linear = p_linear,
    p_quadratic = p_quad,
    p_cubic = p_cubic,
    aic_linear = aic_linear,
    aic_quadratic = aic_quad,
    aic_cubic = aic_cubic,
    best_model = best_model,
    best_r2 = best_r2,
    best_p = best_p,
    best_aic = best_aic
  ))
}

