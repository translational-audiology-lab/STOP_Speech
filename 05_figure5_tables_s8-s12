# Function to clean strings of any special characters
clean_string <- function(x) {
  # Replace any non-ASCII characters with safe equivalents
  x <- gsub("[^\x01-\x7F]+", " ", x)  # Remove non-ASCII
  x <- trimws(x)
  return(x)
}

