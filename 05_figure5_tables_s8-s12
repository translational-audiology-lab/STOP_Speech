# Function to format p-values in scientific notation
format_pval_sci <- function(p) {
  if (is.na(p)) return(NA)
  if (p < 0.0001) {
    return(sprintf("%.2e", p))
  } else if (p < 0.001) {
    return(sprintf("%.2e", p))
  } else if (p < 0.01) {
    return(sprintf("%.4f", p))
  } else {
    return(sprintf("%.4f", p))
  }
}

