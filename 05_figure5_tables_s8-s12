# -----------------------------------------------------------------------------

cat("Creating Table S8: Final Model Coefficients...\n")

vcov_hc3_ws <- sandwich::vcovHC(m_ws, type = "HC3")
vcov_hc3_ps <- sandwich::vcovHC(m_ps, type = "HC3")

se_hc3_ws <- sqrt(diag(vcov_hc3_ws))
se_hc3_ps <- sqrt(diag(vcov_hc3_ps))

coef_ws <- coef(m_ws)
coef_ps <- coef(m_ps)

t_ws <- coef_ws / se_hc3_ws
t_ps <- coef_ps / se_hc3_ps

p_ws <- 2 * (1 - pt(abs(t_ws), df = nrow(data_analysis) - length(coef_ws)))
p_ps <- 2 * (1 - pt(abs(t_ps), df = nrow(data_analysis) - length(coef_ps)))

table_s8 <- tibble(
  Variable    = names(coef_ws),
  WS_Estimate = round(coef_ws, 4),
  WS_SE       = round(se_hc3_ws, 4),
  WS_CI_Lower = round(coef_ws - 1.96 * se_hc3_ws, 4),
  WS_CI_Upper = round(coef_ws + 1.96 * se_hc3_ws, 4),
  WS_t        = round(t_ws, 4),
  WS_pvalue   = signif(p_ws, 3),
  PS_Estimate = round(coef_ps, 4),
  PS_SE       = round(se_hc3_ps, 4),
  PS_CI_Lower = round(coef_ps - 1.96 * se_hc3_ps, 4),
  PS_CI_Upper = round(coef_ps + 1.96 * se_hc3_ps, 4),
  PS_t        = round(t_ps, 4),
  PS_pvalue   = signif(p_ps, 3)
)

