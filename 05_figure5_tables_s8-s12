# -----------------------------------------------------------------------------
# TABLE S12: AGE-STRATIFIED WS vs PS ANALYSIS
# -----------------------------------------------------------------------------

cat("Creating Table S12: Age-Stratified Analysis...\n")

data_with_group <- data_analysis %>%
  dplyr::mutate(
    Age_Group = dplyr::if_else(
      Age <= median(Age),
      "Younger (≤ median)",
      "Older (> median)"
    )
  )

table_s12 <- data_with_group %>%
  dplyr::group_by(Age_Group) %>%
  dplyr::summarise(
    n         = n(),
    Median_Age = round(median(Age), 1),
    WS_Mean   = round(mean(WS), 4),
    WS_SD     = round(sd(WS), 4),
    PS_Mean   = round(mean(PS), 4),
    PS_SD     = round(sd(PS), 4),
    .groups   = "drop"
  )

# Add correlation and regression stats
table_s12$Correlation_r  <- NA_real_
table_s12$Correlation_p  <- NA_real_
table_s12$Slope          <- NA_real_
table_s12$Slope_SE       <- NA_real_
table_s12$Slope_CI_Lower <- NA_real_
table_s12$Slope_CI_Upper <- NA_real_
table_s12$Slope_p        <- NA_real_

for (i in 1:nrow(table_s12)) {
  group      <- table_s12$Age_Group[i]
  group_data <- dplyr::filter(data_with_group, Age_Group == group)
  
  corr_test  <- cor.test(group_data$WS, group_data$PS, method = "pearson")
  lm_fit     <- lm(PS ~ WS, data = group_data)
  lm_summary <- summary(lm_fit)
  
  table_s12$Correlation_r[i]  <- round(corr_test$estimate, 4)
  table_s12$Correlation_p[i]  <- signif(corr_test$p.value, 3)
  table_s12$Slope[i]          <- round(coef(lm_fit)[2], 4)
  table_s12$Slope_SE[i]       <- round(lm_summary$coefficients[2, 2], 4)
  table_s12$Slope_CI_Lower[i] <- round(coef(lm_fit)[2] - 1.96 * lm_summary$coefficients[2, 2], 4)
  table_s12$Slope_CI_Upper[i] <- round(coef(lm_fit)[2] + 1.96 * lm_summary$coefficients[2, 2], 4)
  table_s12$Slope_p[i]        <- signif(lm_summary$coefficients[2, 4], 3)
}

write.csv(table_s12, "output/SuppTable12_Age_Stratified_Analysis.csv",
          row.names = FALSE, fileEncoding = "UTF-8", na = "")

cat("✓ Saved: output/SuppTable12_Age_Stratified_Analysis.csv\n\n")

