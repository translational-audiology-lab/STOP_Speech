# 1. LOAD AND PREPARE DATA
# ==============================================================================

cat("Loading and preparing data...\n")

data <- read_delim("STOP_speech_ABR_clean_v2.csv",
                   delim = ";",
                   locale = locale(decimal_mark = ",", grouping_mark = "", encoding = "UTF-8"),
                   show_col_types = FALSE,
                   na = c("", "NA", "N/A", "#N/A", "NULL"))

names(data) <- make.names(names(data))

numeric_cols <- c("Age", "WS", "PS", "PTA4", "PTAHF", "Oae_5273",
                  "W1.amp", "W1.Plat", "W3.Plat", "W5.Plat")

for (col in numeric_cols) {
  if (col %in% names(data)) {
    if (is.character(data[[col]])) {
      data[[col]] <- gsub(",", ".", data[[col]])
      data[[col]] <- as.numeric(data[[col]])
    }
  }
}

data_all <- data %>%
  select(Age, Sex, WS, PS, PTA4, PTAHF, Oae_5273, W1.Plat, W3.Plat, W5.Plat, Device, W1.amp) %>%
  mutate(Sex_clean = toupper(trimws(Sex))) %>%
  mutate(Sex_clean = case_when(
    Sex_clean %in% c("MAN", "M", "MALE") ~ "M",
    Sex_clean %in% c("WOMAN", "F", "FEMALE") ~ "F",
    TRUE ~ NA_character_
  )) %>%
  select(-Sex) %>%
  rename(Sex = Sex_clean) %>%
  filter(!is.na(Sex), Sex %in% c("M", "F")) %>%
  filter(!is.na(Age), !is.na(WS), !is.na(PS),
         !is.na(PTA4), !is.na(PTAHF), !is.na(Oae_5273),
         !is.na(W1.Plat), !is.na(W3.Plat), !is.na(W5.Plat),
         !is.na(W1.amp),
         is.finite(Age), is.finite(WS), is.finite(PS)) %>%
  mutate(Sex = factor(Sex, levels = c("F", "M")))

data_analysis <- data_all %>%
  mutate(
    Age_c = scale(Age, scale = FALSE)[, 1],
    PTA4_c = scale(PTA4, scale = FALSE)[, 1],
    PTAHF_c = scale(PTAHF, scale = FALSE)[, 1],
    OAE_c = scale(Oae_5273, scale = FALSE)[, 1],
    W1Lat_c = scale(W1.Plat, scale = FALSE)[, 1],
    W1Amp_c = scale(W1.amp, scale = FALSE)[, 1],
    W3Lat_c = scale(W3.Plat, scale = FALSE)[, 1],
    W5Lat_c = scale(W5.Plat, scale = FALSE)[, 1],
    Age_c2 = Age_c^2,
    PTA4_c2 = PTA4_c^2,
    PTAHF_c2 = PTAHF_c^2,
    PTAHF_c3 = PTAHF_c^3,
    OAE_c2 = OAE_c^2,
