# ==============================================================================
# FIGURE 5 GENERATION - REVISED (No panel labels, updated annotations)
# ==============================================================================
# Insert this code section into your 05_figure5_lrt.r script
# Replace the PART 5 section (starting at "# PANEL A: Aging Trajectories")
# ==============================================================================

cat("════════════════════════════════════════════════════════════════════════\n")
cat("GENERATING FIGURE 5: 4-PANEL PUBLICATION FIGURE (REVISED)\n")
cat("════════════════════════════════════════════════════════════════════════\n\n")

# Get key p-values for annotation
p_ws_age2 <- summary(m_ws)$coefficients["Age_c2", "Pr(>|t|)"]
p_ps_age2 <- summary(m_ps)$coefficients["Age_c2", "Pr(>|t|)"]

# Format for Panel A annotation (both WS and PS with R² and p-values)
r2_text_ws <- sprintf("WS: R²=%.3f, p=%s", r2_ws, format_pval_sci(p_ws_age2))
r2_text_ps <- sprintf("PS: R²=%.3f, p=%s", r2_ps, format_pval_sci(p_ps_age2))
r2_text_combined <- paste0(r2_text_ws, "\n", r2_text_ps)

# ============================================================================
# PANEL A: Aging Trajectories (with WS & PS R² and p-values)
# ============================================================================

age_seq <- seq(min(data_analysis$Age), max(data_analysis$Age), length.out = 100)
age_c_seq <- age_seq - mean(data_analysis$Age)

pred_data <- tibble(
  Age_c = age_c_seq, Age_c2 = age_c_seq^2,
  Sex = factor("Woman", levels = levels(data_analysis$Sex)),
  PTA4_c = 0, PTA4_c2 = 0,
  PTAHF_c = 0, PTAHF_c2 = 0, PTAHF_c3 = 0,
  OAE_c = 0, OAE_c2 = 0, OAE_c3 = 0,
  W1Lat_c = 0, Age_x_W1Lat = 0,
  W1Amp_c = 0, Age_x_W1Amp = 0,
  W3Lat_c = 0, W3Lat_c2 = 0, W3Lat_c3 = 0,
  W5Lat_c = 0
)

pred_ws_fit <- predict(m_ws, newdata = pred_data, se.fit = TRUE)
pred_ps_fit <- predict(m_ps, newdata = pred_data, se.fit = TRUE)

pred_combined <- bind_rows(
  tibble(Age = age_seq, Score = "Word Score",
         Fitted = pred_ws_fit$fit, SE = pred_ws_fit$se.fit,
         CI_Lower = pred_ws_fit$fit - 1.96 * pred_ws_fit$se.fit,
         CI_Upper = pred_ws_fit$fit + 1.96 * pred_ws_fit$se.fit),
  tibble(Age = age_seq, Score = "Phoneme Score",
         Fitted = pred_ps_fit$fit, SE = pred_ps_fit$se.fit,
         CI_Lower = pred_ps_fit$fit - 1.96 * pred_ps_fit$se.fit,
         CI_Upper = pred_ps_fit$fit + 1.96 * pred_ps_fit$se.fit)
)

panel_a <- ggplot(data_analysis, aes(x = Age)) +
  geom_point(aes(y = WS, color = "Word Score"), alpha = 0.4, size = 1) +
  geom_point(aes(y = PS, color = "Phoneme Score"), alpha = 0.4, size = 1) +
  geom_ribbon(data = filter(pred_combined, Score == "Word Score"),
              aes(ymin = CI_Lower, ymax = CI_Upper, fill = "Word Score"), alpha = 0.12) +
  geom_ribbon(data = filter(pred_combined, Score == "Phoneme Score"),
              aes(ymin = CI_Lower, ymax = CI_Upper, fill = "Phoneme Score"), alpha = 0.12) +
  geom_line(data = filter(pred_combined, Score == "Word Score"),
            aes(y = Fitted, color = "Word Score"), linewidth = 1) +
  geom_line(data = filter(pred_combined, Score == "Phoneme Score"),
            aes(y = Fitted, color = "Phoneme Score"), linewidth = 1) +
  annotate("text", x = min(data_analysis$Age) + 2, y = max(data_analysis$PS) - 2,
           label = r2_text_combined, hjust = 0, vjust = 1, size = 8/.pt, family = "sans") +
  scale_color_manual(values = c("Word Score" = "#E74C3C", "Phoneme Score" = "#3498DB")) +
  scale_fill_manual(values = c("Word Score" = "#E74C3C", "Phoneme Score" = "#3498DB")) +
  labs(x = "Age (years)", y = "Score (%)") +
  theme_minimal() +
  theme(legend.position = "none", 
        panel.grid.minor = element_blank(),
        axis.title = element_text(size = 10),
        axis.text = element_text(size = 8),
        aspect.ratio = 1)

# ============================================================================
# PANEL B: Forest Plot (NO LEGEND)
# ============================================================================

forest_long <- bind_rows(
  forest_data %>%
    select(Predictor, est = WS_est, ci_lower = WS_ci_lower, ci_upper = WS_ci_upper) %>%
    mutate(Outcome = "Word Score"),
  forest_data %>%
    select(Predictor, est = PS_est, ci_lower = PS_ci_lower, ci_upper = PS_ci_upper) %>%
    mutate(Outcome = "Phoneme Score")
) %>%
  mutate(Predictor = factor(Predictor, levels = forest_data$Predictor))

panel_b <- ggplot(forest_long, aes(x = est, y = Predictor, color = Outcome)) +
  geom_vline(xintercept = 0, linetype = "dashed", color = "gray50", linewidth = 0.5) +
  geom_point(position = position_dodge(width = 0.5), size = 1.5, alpha = 0.8) +
  geom_linerange(aes(xmin = ci_lower, xmax = ci_upper),
                 position = position_dodge(width = 0.5), linewidth = 0.8, alpha = 0.7) +
  scale_color_manual(values = c("Word Score" = "#E74C3C", "Phoneme Score" = "#3498DB"),
                     name = NULL) +
  labs(x = "Coefficient (95% CI)", y = NULL) +
  theme_minimal() +
  theme(legend.position = "none",  # REMOVED LEGEND
        panel.grid.minor = element_blank(),
        panel.grid.major.y = element_line(color = "gray90", linewidth = 0.2),
        axis.title = element_text(size = 10),
        axis.text = element_text(size = 8),
        aspect.ratio = 1)

# ============================================================================
# PANEL C: Age × W1.Latency Interaction (NO LEGEND)
# ============================================================================

age_groups_fig <- c(45, 55, 65, 75)
w1lat_seq <- seq(min(data_analysis$W1.Plat), max(data_analysis$W1.Plat), length.out = 100)
w1lat_c_seq <- w1lat_seq - mean(data_analysis$W1.Plat)

interaction_pred_fig <- expand_grid(
  Age = age_groups_fig,
  W1Lat = w1lat_seq
) %>%
  mutate(
    Age_c = Age - mean(data_analysis$Age),
    Age_c2 = Age_c^2,
    W1Lat_c = W1Lat - mean(data_analysis$W1.Plat),
    Age_x_W1Lat = Age_c * W1Lat_c,
    Sex = factor("Woman", levels = levels(data_analysis$Sex)),
    PTA4_c = 0, PTA4_c2 = 0,
    PTAHF_c = 0, PTAHF_c2 = 0, PTAHF_c3 = 0,
    OAE_c = 0, OAE_c2 = 0, OAE_c3 = 0,
    W1Amp_c = 0, Age_x_W1Amp = 0,
    W3Lat_c = 0, W3Lat_c2 = 0, W3Lat_c3 = 0,
    W5Lat_c = 0
  )

interaction_pred_fig$Pred_WS <- predict(m_ws, newdata = interaction_pred_fig)
interaction_pred_fig$Pred_PS <- predict(m_ps, newdata = interaction_pred_fig)

int_plot_combined <- bind_rows(
  interaction_pred_fig %>% select(W1Lat, Age, Pred_WS) %>%
    rename(Predicted = Pred_WS) %>% mutate(Outcome = "WS"),
  interaction_pred_fig %>% select(W1Lat, Age, Pred_PS) %>%
    rename(Predicted = Pred_PS) %>% mutate(Outcome = "PS")
) %>%
  mutate(Age_label = paste0(Age, "y"))

panel_c <- ggplot(int_plot_combined, aes(x = W1Lat, y = Predicted, 
                                         color = Age_label, linetype = Outcome)) +
  geom_line(linewidth = 0.9, alpha = 0.8) +
  scale_color_manual(name = "Age",
                     values = c("45y" = "#2ECC71", "55y" = "#F39C12",
                                "65y" = "#E67E22", "75y" = "#E74C3C")) +
  scale_linetype_manual(name = "Outcome",
                        values = c("WS" = "solid", "PS" = "dashed")) +
  labs(x = "W1.Latency (ms)", y = "Predicted Score (%)") +
  theme_minimal() +
  theme(legend.position = "none",  # REMOVED LEGEND
        panel.grid.minor = element_blank(),
        axis.title = element_text(size = 10),
        axis.text = element_text(size = 8),
        aspect.ratio = 1)

# ============================================================================
# PANEL D: WS vs PS with Age Gradient (Keep legend on right)
# ============================================================================

panel_d <- ggplot(data_analysis, aes(x = WS, y = PS, color = Age)) +
  geom_point(alpha = 0.5, size = 1.2) +
  geom_smooth(method = "lm", se = TRUE, color = "gray30", 
              fill = "gray80", alpha = 0.2, linewidth = 0.8) +
  scale_color_viridis_c(name = "Age (years)", option = "plasma") +
  labs(x = "Word Score (%)", y = "Phoneme Score (%)") +
  theme_minimal() +
  theme(legend.position = "right",
        panel.grid.minor = element_blank(),
        axis.title = element_text(size = 10),
        axis.text = element_text(size = 8),
        legend.text = element_text(size = 8),
        legend.title = element_text(size = 9),
        aspect.ratio = 1)

# ============================================================================
# COMBINE 2×2 LAYOUT (NO PANEL LABELS)
# ============================================================================

combined_figure <- (panel_a + panel_b) / (panel_c + panel_d) +
  plot_layout(ncol = 2, nrow = 2)

# Save Figure 5
ggsave("output/figures/Figure5_Differential_Neural_Mechanisms_LRT.png", 
       combined_figure, width = 10, height = 10, dpi = 300, device = "png")

ggsave("output/figures/Figure5_Differential_Neural_Mechanisms_LRT.pdf",
       combined_figure, width = 10, height = 10, dpi = 300, device = "pdf")

cat("✓ Saved: output/figures/Figure5_Differential_Neural_Mechanisms_LRT.png\n")
cat("✓ Saved: output/figures/Figure5_Differential_Neural_Mechanisms_LRT.pdf\n\n")

