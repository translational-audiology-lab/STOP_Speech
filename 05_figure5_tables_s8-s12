# TABLE S12: AGE-STRATIFIED ANALYSIS
cat("Creating Table S12: Age-Stratified WS vs PS Analysis...\n")

data_analysis_with_group <- data_analysis %>%
  mutate(Age_Group = if_else(Age <= median(Age), "Young (less than or equal to median)", "Old (greater than median)"))

table_s12 <- data_analysis_with_group %>%
  group_by(Age_Group) %>%
  summarise(
    n = n(),
    Median_Age = round(median(Age), 1),
    WS_Mean = round(mean(WS, na.rm = TRUE), 4),
    WS_SD = round(sd(WS, na.rm = TRUE), 4),
    PS_Mean = round(mean(PS, na.rm = TRUE), 4),
    PS_SD = round(sd(PS, na.rm = TRUE), 4),
    .groups = "drop"
  )

for (i in 1:nrow(table_s12)) {
  group <- table_s12$Age_Group[i]
  group_data <- filter(data_analysis_with_group, Age_Group == group)
  
  corr_test <- cor.test(group_data$WS, group_data$PS, method = "pearson")
  lm_fit <- lm(PS ~ WS, data = group_data)
  lm_summary <- summary(lm_fit)
  
  table_s12$Correlation_r[i] <- round(corr_test$estimate, 4)
  table_s12$Correlation_p[i] <- format_pval_sci(corr_test$p.value)
  table_s12$Slope[i] <- round(coef(lm_fit)[2], 4)
  table_s12$Slope_SE[i] <- round(lm_summary$coefficients[2, 2], 4)
  table_s12$Slope_CI_Lower[i] <- round(coef(lm_fit)[2] - 1.96 * lm_summary$coefficients[2, 2], 4)
  table_s12$Slope_CI_Upper[i] <- round(coef(lm_fit)[2] + 1.96 * lm_summary$coefficients[2, 2], 4)
  table_s12$Slope_p[i] <- format_pval_sci(lm_summary$coefficients[2, 4])
}

table_s12 <- table_s12 %>%
  select(Age_Group, n, Median_Age, WS_Mean, WS_SD, PS_Mean, PS_SD,
         Correlation_r, Correlation_p, Slope, Slope_SE, Slope_CI_Lower, Slope_CI_Upper, Slope_p) %>%
  mutate(across(where(is.character), clean_string))

write.csv(table_s12, "output/tables/SuppTable12_Age_Stratified_Analysis.csv",
          row.names = FALSE, fileEncoding = "UTF-8", na = "")

cat(" OK: output/tables/SuppTable12_Age_Stratified_Analysis.csv\n\n")

