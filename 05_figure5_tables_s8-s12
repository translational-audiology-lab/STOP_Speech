# TABLE S11: INTERACTION TRAJECTORIES
cat("Creating Table S11: Age x W1.Latency Interaction Trajectories...\n")

age_groups <- tibble(Age = c(45, 55, 65, 75))
w1lat_levels <- quantile(data_analysis$W1.Plat, probs = c(0, 0.25, 0.5, 0.75, 1))
w1lat_labels <- c("Minimum", "Q1", "Median", "Q3", "Maximum")

interaction_pred <- expand_grid(
  Age = age_groups$Age,
  W1Lat = w1lat_levels
) %>%
  mutate(
    W1Lat_label = rep(w1lat_labels, nrow(age_groups)),
    Age_c = Age - mean(data_analysis$Age),
    Age_c2 = Age_c^2,
    W1Lat_c = W1Lat - mean(data_analysis$W1.Plat),
    Age_x_W1Lat = Age_c * W1Lat_c,
    Sex = "F",
    PTA4_c = 0, PTA4_c2 = 0,
    PTAHF_c = 0, PTAHF_c2 = 0, PTAHF_c3 = 0,
    OAE_c = 0, OAE_c2 = 0, OAE_c3 = 0,
    W1Amp_c = 0, Age_x_W1Amp = 0,
    W3Lat_c = 0, W3Lat_c2 = 0, W3Lat_c3 = 0,
    W5Lat_c = 0
  )

pred_matrix <- interaction_pred %>%
