m2_ws <- lm(WS ~ Age_c + Age_c2 + Sex + PTA4_c + PTA4_c2 + PTAHF_c + PTAHF_c2 + PTAHF_c3 + OAE_c + OAE_c2 + OAE_c3 + W1Lat_c + Age_x_W1Lat + W1Amp_c + Age_x_W1Amp + W3Lat_c + W3Lat_c2 + W3Lat_c3 + W5Lat_c, data = data_analysis)

