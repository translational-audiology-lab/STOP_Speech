create_table1 <- function(data) {
  total_n <- nrow(data)
  results <- data.frame(
    Variable = character(),
    Mean_SD_or_N = character(),
    Range = character(),
    stringsAsFactors = FALSE
  )
  
  results <- rbind(results, data.frame(Variable = "N (ears)", Mean_SD_or_N = as.character(total_n), Range = "-", stringsAsFactors = FALSE))
  
  age_stats <- calc_summary(data$Age)
  results <- rbind(results, data.frame(Variable = "Age (years)", Mean_SD_or_N = age_stats$mean_sd, Range = age_stats$range, stringsAsFactors = FALSE))
  
  sex_table <- table(data$Sex, useNA = "no")
  if (length(sex_table) >= 2) {
    female_idx <- which(names(sex_table) %in% c("Woman", "Female", "F"))
    sex_female <- ifelse(length(female_idx) > 0, sex_table[female_idx[1]], sex_table[2])
    sex_pct <- round(100 * sex_female / total_n, 0)
    results <- rbind(results, data.frame(Variable = "Sex (female)", Mean_SD_or_N = sprintf("%d (%d%%)", sex_female, sex_pct), Range = "-", stringsAsFactors = FALSE))
  }
  
  pta4_stats <- calc_summary(data$PTA4)
  results <- rbind(results, data.frame(Variable = "PTA4 (0.5-4 kHz) dB HL", Mean_SD_or_N = pta4_stats$mean_sd, Range = pta4_stats$range, stringsAsFactors = FALSE))
  
  ptahf_stats <- calc_summary(data$PTAHF)
  results <- rbind(results, data.frame(Variable = "PTAeHF (10-16 kHz) dB HL", Mean_SD_or_N = ptahf_stats$mean_sd, Range = ptahf_stats$range, stringsAsFactors = FALSE))
  
  ucl_stats <- calc_summary(data$UCL8000)
  results <- rbind(results, data.frame(Variable = "LDL8kHz (dB HL)", Mean_SD_or_N = ucl_stats$mean_sd, Range = ucl_stats$range, stringsAsFactors = FALSE))
  
  oae_stats <- calc_summary(data$Oae_5273)
  results <- rbind(results, data.frame(Variable = "OAE5273 (dB SNR)", Mean_SD_or_N = oae_stats$mean_sd, Range = oae_stats$range, stringsAsFactors = FALSE))
  
  ws_stats <- calc_summary(data$WS)
  results <- rbind(results, data.frame(Variable = "Word score (%)", Mean_SD_or_N = ws_stats$mean_sd, Range = ws_stats$range, stringsAsFactors = FALSE))
  
  ps_stats <- calc_summary(data$PS)
  results <- rbind(results, data.frame(Variable = "Phoneme score (%)", Mean_SD_or_N = ps_stats$mean_sd, Range = ps_stats$range, stringsAsFactors = FALSE))
  
  eclipse_data <- data %>% filter(!is.na(Device) & Device == "Eclipse")
  w1amp_stats <- calc_summary(eclipse_data$W1.amp)
  results <- rbind(results, data.frame(Variable = "Wave I amplitude - Eclipse (uV)", Mean_SD_or_N = w1amp_stats$mean_sd, Range = w1amp_stats$range, stringsAsFactors = FALSE))
  
  w1lat_stats <- calc_summary(data$W1.Plat)
  results <- rbind(results, data.frame(Variable = "Wave I latency (ms)", Mean_SD_or_N = w1lat_stats$mean_sd, Range = w1lat_stats$range, stringsAsFactors = FALSE))
  
  w3lat_stats <- calc_summary(data$W3.Plat)
  results <- rbind(results, data.frame(Variable = "Wave III latency (ms)", Mean_SD_or_N = w3lat_stats$mean_sd, Range = w3lat_stats$range, stringsAsFactors = FALSE))
  
  w5lat_stats <- calc_summary(data$W5.Plat)
  results <- rbind(results, data.frame(Variable = "Wave V latency (ms)", Mean_SD_or_N = w5lat_stats$mean_sd, Range = w5lat_stats$range, stringsAsFactors = FALSE))
  
  iv_latency <- data$W5.Plat - data$W1.Plat
  ivlat_stats <- calc_summary(iv_latency)
  results <- rbind(results, data.frame(Variable = "I-V inter-wave latency (ms)", Mean_SD_or_N = ivlat_stats$mean_sd, Range = ivlat_stats$range, stringsAsFactors = FALSE))
  
  colnames(results) <- c("Variable", "Mean +/- SD or N (%)", "Range")
  return(results)
}

# ==============================================================================
# Generate stratified demographics tables
# ==============================================================================

create_stratified_table <- function(data, group_var, group_label = NULL) {
  if(is.null(group_label)) group_label <- group_var
  
  groups <- sort(unique(data[[group_var]][!is.na(data[[group_var]])]))
  data$IV_latency <- data$W5.Plat - data$W1.Plat
  
  vars_list <- list(
    list(name = "N (ears)", var = NULL, type = "count"),
    list(name = "Age (years)", var = "Age", type = "numeric"),
    list(name = "Woman (%)", var = "Sex", type = "sex"),
    list(name = "PTA4 (0.5-4 kHz) dB HL", var = "PTA4", type = "numeric"),
    list(name = "PTAeHF (10-16 kHz) dB HL", var = "PTAHF", type = "numeric"),
    list(name = "LDL8kHz (dB HL)", var = "UCL8000", type = "numeric"),
    list(name = "OAE5273 (dB SNR)", var = "Oae_5273", type = "numeric"),
    list(name = "Word score (%)", var = "WS", type = "numeric"),
    list(name = "Phoneme score (%)", var = "PS", type = "numeric"),
    list(name = "Wave I amplitude - Eclipse (uV)", var = "W1.amp", type = "eclipse"),
    list(name = "Wave I latency (ms)", var = "W1.Plat", type = "numeric"),
    list(name = "Wave III latency (ms)", var = "W3.Plat", type = "numeric"),
    list(name = "Wave V latency (ms)", var = "W5.Plat", type = "numeric"),
    list(name = "I-V inter-wave latency (ms)", var = "IV_latency", type = "numeric")
  )
  
  result_rows <- list()
  
  for (var_info in vars_list) {
    row <- c(Variable = var_info$name)
    for (grp in groups) {
      grp_data <- data[!is.na(data[[group_var]]) & data[[group_var]] == grp, ]
      
      if (var_info$type == "count") {
        row <- c(row, as.character(nrow(grp_data)))
      } else if (var_info$type == "numeric") {
        stats <- calc_summary(grp_data[[var_info$var]])
        row <- c(row, stats$mean_sd)
      } else if (var_info$type == "eclipse") {
        eclipse_grp <- grp_data %>% filter(!is.na(Device) & Device == "Eclipse")
        if (sum(!is.na(eclipse_grp[[var_info$var]])) > 0) {
          stats <- calc_summary(eclipse_grp[[var_info$var]])
          row <- c(row, stats$mean_sd)
        } else {
          row <- c(row, "-")
        }
      } else if (var_info$type == "sex") {
        sex_table <- table(grp_data$Sex, useNA = "no")
        if (length(sex_table) >= 2) {
          female_idx <- which(names(sex_table) %in% c("Woman", "Female", "F"))
          female_count <- ifelse(length(female_idx) > 0, sex_table[female_idx[1]], sex_table[2])
          female_pct <- round(100 * female_count / nrow(grp_data), 0)
          row <- c(row, sprintf("%d (%d%%)", female_count, female_pct))
        } else {
          row <- c(row, "-")
        }
      }
    }
    result_rows[[length(result_rows) + 1]] <- row
  }
  
  results <- as.data.frame(do.call(rbind, result_rows), stringsAsFactors = FALSE)
  colnames(results) <- c("Variable", as.character(groups))
  return(results)
}

