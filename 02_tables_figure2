# ==============================================================================
# Summary statistics helper function
# ==============================================================================

calc_summary <- function(x, na.rm = TRUE) {
  x_clean <- x[!is.na(x)]
  
  if (length(x_clean) == 0) {
    return(list(mean_sd = "-", range = "-", n = 0))
  }
  
  if (length(x_clean) == 1) {
    val <- x_clean[1]
    return(list(
      mean_sd = sprintf("%.1f", val),
      range = sprintf("%.1f to %.1f", val, val),
      n = 1
    ))
  }
  
  mean_val <- mean(x_clean)
  sd_val <- sd(x_clean)
  min_val <- min(x_clean)
  max_val <- max(x_clean)
  
  return(list(
    mean_sd = sprintf("%.1f +/- %.1f", mean_val, sd_val),
    range = sprintf("%.1f to %.1f", min_val, max_val),
    n = length(x_clean)
  ))
}

# ==============================================================================
# Standard error function
# ==============================================================================

std_error <- function(x) sd(x, na.rm = TRUE) / sqrt(sum(!is.na(x)))

