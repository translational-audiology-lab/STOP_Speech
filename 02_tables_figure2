# Helper function for latency panels with device separation
make_latency_panel_separate <- function(data_in, wave_var, y_label, panel_letter) {
  data_plot <- data_in %>%
    filter(!is.na(!!sym(wave_var)), !is.na(age_group), !is.na(Device)) %>%
    mutate(
      device_color = case_when(
        Device == "Eclipse" ~ colors_eclipse[as.character(age_group)],
        Device == "Chartr" ~ colors_chartr[as.character(age_group)],
        TRUE ~ NA_character_
      )
    )
  
  if (nrow(data_plot) == 0) {
    return(NULL)
  }
  
  y_range <- range(data_plot[[wave_var]], na.rm = TRUE)
  y_buffer <- (y_range[2] - y_range[1]) * 0.02
  y_lim <- c(y_range[1] - y_buffer, y_range[2] + y_buffer)
  
  ggplot(
    data_plot,
    aes(x = age_group, y = !!sym(wave_var), fill = age_group)
  ) +
    geom_point(
      data = filter(data_plot, Device == "Eclipse"),
      aes(x = as.numeric(age_group) - 0.37, color = device_color),
