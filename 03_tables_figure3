data <- readRDS("output/data_clean.rds")

# ==============================================================================
# Generate Table S5: Age effects with polynomial regression
# ==============================================================================

variables_age <- c("PTA4", "PTAHF", "Oae_5273", "WS", "PS", 
                   "W1.amp", "W1.Plat", "W3.Plat", "W5.Plat")

var_labels <- c(
  "PTA4" = "PTA4",
  "PTAHF" = "PTAHF",
  "Oae_5273" = "OAE",
  "WS" = "WS",
  "PS" = "PS",
  "W1.amp" = "W1.Amplitude",
  "W1.Plat" = "W1.Latency",
  "W3.Plat" = "W3.Latency",
  "W5.Plat" = "W5.Latency"
)

results_age <- list()
best_fit_models <- list()

for (var in variables_age) {
  if (var == "W1.amp") {
    analysis_data <- data %>% filter(!is.na(Device) & Device == "Eclipse")
  } else {
    analysis_data <- data
  }
  
  result <- fit_polynomial_models_aic(analysis_data, var, "Age")
  
  results_age[[var]] <- data.frame(
    Variable = var_labels[var],
    n = result$n,
    R2_linear = sprintf("%.4f", result$r2_linear),
    p_linear = format_pvalue_scientific(result$p_linear),
    AIC_linear = sprintf("%.2f", result$aic_linear),
    R2_quadratic = sprintf("%.4f", result$r2_quadratic),
    p_quadratic = format_pvalue_scientific(result$p_quadratic),
    AIC_quadratic = sprintf("%.2f", result$aic_quadratic),
    R2_cubic = sprintf("%.4f", result$r2_cubic),
    p_cubic = format_pvalue_scientific(result$p_cubic),
    AIC_cubic = sprintf("%.2f", result$aic_cubic),
    Best_fit = result$best_model
  )
  
  best_fit_models[[var]] <- list(
    model = result$best_model,
    r2 = result$best_r2,
    p = result$best_p
  )
}

supp_table5 <- bind_rows(results_age)
write.table(supp_table5, "output/SuppTable5_Age_effects.csv", 
            row.names = FALSE, sep = ";", quote = FALSE)

saveRDS(best_fit_models, "output/best_fit_models.rds")

# ==============================================================================
# Generate Table S6: Age × Sex effects
# ==============================================================================

data_analysis <- data %>%
  filter(!is.na(WS), !is.na(PS), !is.na(Age), !is.na(Sex)) %>%
  filter(is.finite(WS), is.finite(PS), is.finite(Age)) %>%
  mutate(
    Sex = relevel(as.factor(Sex), ref = "Man"),
    Age_c = Age - mean(Age, na.rm = TRUE),
    Age_sq = Age_c^2,
    Age_cu = Age_c^3,
    SexWoman = ifelse(Sex == "Woman", 1, 0)
  )

all_results <- list()
outcomes <- c("WS", "PS")
model_specs <- list(
  model_1.1 = list(formula_str = "~ Age_c", label = "1.1_Age"),
  model_1.2 = list(formula_str = "~ Age_c + Age_sq", label = "1.2_Age_quad"),
  model_1.3 = list(formula_str = "~ Age_c + Age_sq + Age_cu", label = "1.3_Age_cubic"),
  model_1.4 = list(formula_str = "~ SexWoman", label = "1.4_Sex"),
  model_1.5 = list(formula_str = "~ Age_c + SexWoman", label = "1.5_Age_Sex"),
  model_1.6 = list(formula_str = "~ Age_c * SexWoman", label = "1.6_Age_x_Sex")
)

for (outcome in outcomes) {
  for (model_name in names(model_specs)) {
    spec <- model_specs[[model_name]]
    formula_obj <- as.formula(paste(outcome, spec$formula_str))
    m <- lm(formula_obj, data = data_analysis)
    
    tidy_results <- tidy(m, conf.int = TRUE) %>%
      mutate(
        model = spec$label,
        outcome = outcome,
        estimate = round(estimate, 4),
        std.error = round(std.error, 4),
        statistic = round(statistic, 4),
        p.value = format_pvalue_scientific(p.value),
        conf.low = round(conf.low, 4),
        conf.high = round(conf.high, 4)
      ) %>%
      select(model, outcome, term, estimate, std.error, statistic, p.value, conf.low, conf.high)
    
    all_results[[paste(outcome, spec$label, sep = "_")]] <- tidy_results
  }
}

supp_table6 <- bind_rows(all_results) %>%
  arrange(outcome, match(model, c("1.1_Age", "1.4_Sex", "1.2_Age_quad", "1.3_Age_cubic", 
                                  "1.5_Age_Sex", "1.6_Age_x_Sex")))

write.csv(supp_table6, "output/SuppTable6_Age_x_Sex_effects.csv", 
          row.names = FALSE, quote = FALSE)

