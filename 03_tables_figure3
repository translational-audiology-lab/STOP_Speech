# Format p-value with proper scientific notation
format_pvalue_scientific <- function(p_values) {
  sapply(p_values, function(p) {
    if (is.na(p) || !is.finite(p)) {
      return("NA")
    }
    return(sprintf("%.2e", p))
  })
}

# Format p-value for display (threshold)
format_pvalue_display <- function(p) {
  if (is.na(p) || !is.finite(p)) return("NA")
  if (p < 0.001) return("<0.001")
  return(sprintf("%.4f", p))
}

# ==============================================================================
# MAIN FUNCTION: Hierarchical LRT-based polynomial model selection
# ==============================================================================
# Sequential testing per best practice:
# Step 1: Is quadratic significantly better than linear? (p_quad < 0.05?)
#         YES → consider quadratic; proceed to Step 2
#         NO  → use linear; STOP
# Step 2: Is cubic significantly better than quadratic? (p_cubic < 0.05?)
#         YES → use cubic
#         NO  → use quadratic

fit_polynomial_models_lrt <- function(df, outcome_var, predictor_var, alpha = 0.05) {
  
  # Data preparation
  model_data <- df %>%
    select(all_of(c(outcome_var, predictor_var))) %>%
    filter(!is.na(.[[outcome_var]]), !is.na(.[[predictor_var]]),
           is.finite(.[[outcome_var]]), is.finite(.[[predictor_var]]))
  
  if (nrow(model_data) < 10) {
    return(list(
      n = nrow(model_data),
      r2_linear = NA, r2_quadratic = NA, r2_cubic = NA,
      p_linear = NA, p_quadratic = NA, p_cubic = NA,
      best_model = "Insufficient data",
      best_r2 = NA,
      best_p = NA,
      reason = "N < 10"
    ))
  }
  
  # Center predictor
  X <- model_data[[predictor_var]]
  X_centered <- X - mean(X)
  model_data$X_centered <- X_centered
  model_data$X2 <- X_centered^2
  model_data$X3 <- X_centered^3
  
  # Fit all three models
  m_linear <- lm(as.formula(paste(outcome_var, "~ X_centered")), data = model_data)
  m_quad   <- lm(as.formula(paste(outcome_var, "~ X_centered + X2")), data = model_data)
  m_cubic  <- lm(as.formula(paste(outcome_var, "~ X_centered + X2 + X3")), data = model_data)
  
  # Extract R² values
  r2_linear <- summary(m_linear)$r.squared
  r2_quad   <- summary(m_quad)$r.squared
  r2_cubic  <- summary(m_cubic)$r.squared
  
  # Get p-value for linear model (F-test on the full model)
  fstat_linear <- summary(m_linear)$fstatistic
  p_linear <- 1 - pf(fstat_linear[1], fstat_linear[2], fstat_linear[3])
  
  # LRT: Linear vs Quadratic
  anova_quad <- anova(m_linear, m_quad)
  p_quad <- anova_quad$`Pr(>F)`[2]
  
  # LRT: Quadratic vs Cubic
  anova_cubic <- anova(m_quad, m_cubic)
  p_cubic <- anova_cubic$`Pr(>F)`[2]
  
  # ===========================================================================
  # HIERARCHICAL LRT DECISION RULE (α = 0.05)
  # ===========================================================================
  
  if (p_quad < alpha) {
    # Quadratic is significantly better than linear
    # Now test: is cubic significantly better than quadratic?
    if (p_cubic < alpha) {
      # YES: Cubic is best
      best_model <- "Cubic"
      best_r2 <- r2_cubic
      best_p <- p_cubic
      reason <- sprintf("Cubic better (p_cubic=%.4f < 0.05)", p_cubic)
    } else {
      # NO: Quadratic is best
      best_model <- "Quadratic"
      best_r2 <- r2_quad
      best_p <- p_quad
      reason <- sprintf("Quadratic best (p_quad=%.4f < 0.05, p_cubic=%.4f ≥ 0.05)", 
                        p_quad, p_cubic)
    }
  } else {
    # Quadratic NOT significantly better; use linear
    best_model <- "Linear"
    best_r2 <- r2_linear
    best_p <- p_linear
    reason <- sprintf("Linear (p_quad=%.4f ≥ 0.05)", p_quad)
  }
  
  return(list(
    n = nrow(model_data),
    r2_linear = r2_linear,
    r2_quadratic = r2_quad,
    r2_cubic = r2_cubic,
    p_linear = p_linear,
    p_quadratic = p_quad,
    p_cubic = p_cubic,
    best_model = best_model,
    best_r2 = best_r2,
    best_p = best_p,
    reason = reason
  ))
}

