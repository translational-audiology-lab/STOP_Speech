best_fit_models <- readRDS("output/best_fit_models.rds")

create_corr_plot <- function(df, y_col, y_label, best_model_type, best_r2, best_p, reverse_y = FALSE) {
  
  plot_data <- df %>%
    select(all_of(c("Age", y_col))) %>%
    filter(!is.na(Age), !is.na(.[[y_col]]),
           is.finite(Age), is.finite(.[[y_col]]))
  
  if (nrow(plot_data) < 3) {
    return(ggplot() + theme_void() +
             annotate("text", x = 0.5, y = 0.5, label = "Insufficient data", size = 4))
  }
  
  X_centered <- scale(plot_data$Age, scale = FALSE)
  plot_data_poly <- plot_data
  plot_data_poly$Age_centered <- as.numeric(X_centered)
  plot_data_poly$Age2 <- plot_data_poly$Age_centered^2
  plot_data_poly$Age3 <- plot_data_poly$Age_centered^3
  
  m_linear <- lm(as.formula(paste(y_col, "~ Age_centered")), data = plot_data_poly)
  m_quad <- lm(as.formula(paste(y_col, "~ Age_centered + Age2")), data = plot_data_poly)
  m_cubic <- lm(as.formula(paste(y_col, "~ Age_centered + Age2 + Age3")), data = plot_data_poly)
  
  if (best_model_type == "Linear") {
    m_best <- m_linear
    line_color <- "#1f77b4"
  } else if (best_model_type == "Quadratic") {
    m_best <- m_quad
    line_color <- "#ff7f0e"
  } else {
    m_best <- m_cubic
    line_color <- "#d62728"
  }
  
  x_min <- min(plot_data$Age)
  x_max <- max(plot_data$Age)
  x_range <- seq(x_min, x_max, length.out = 200)
  
  if (best_model_type == "Linear") {
    Age_centered_range <- x_range - mean(plot_data$Age)
    pred_df <- data.frame(Age_centered = Age_centered_range)
    pred_fit <- predict(m_best, newdata = pred_df, se.fit = TRUE)
  } else if (best_model_type == "Quadratic") {
    Age_centered_range <- x_range - mean(plot_data$Age)
    pred_df <- data.frame(Age_centered = Age_centered_range, Age2 = Age_centered_range^2)
    pred_fit <- predict(m_best, newdata = pred_df, se.fit = TRUE)
  } else {
    Age_centered_range <- x_range - mean(plot_data$Age)
    pred_df <- data.frame(Age_centered = Age_centered_range, 
                          Age2 = Age_centered_range^2, 
                          Age3 = Age_centered_range^3)
    pred_fit <- predict(m_best, newdata = pred_df, se.fit = TRUE)
  }
  
  fit_data <- data.frame(x = x_range, y = pred_fit$fit, se = pred_fit$se.fit)
  
  p <- ggplot(plot_data, aes(x = Age, y = .data[[y_col]])) +
    geom_point(alpha = 0.4, size = 2, color = "gray40") +
    geom_line(data = fit_data, aes(x = x, y = y),
              color = line_color, size = 1, linetype = "solid") +
    geom_ribbon(data = fit_data, aes(x = x, ymin = y - 1.96*se, ymax = y + 1.96*se),
                alpha = 0.15, fill = line_color, inherit.aes = FALSE)
  
  if (reverse_y) {
    p <- p + scale_y_reverse(name = y_label)
  } else {
    p <- p + scale_y_continuous(name = y_label)
  }
  
  p_text <- format_pvalue_scientific(best_p)
  subtitle_text <- bquote(italic(R)^2 ~ "=" ~ .(sprintf("%.3f", best_r2)) ~ 
                            ", " ~ italic(p) ~ "=" ~ .(p_text))
  
  p <- p +
    scale_x_continuous(name = "Age (years)") +
    theme_minimal() +
    theme(
      axis.title = element_text(size = 12, face = "plain", family = "Helvetica"),
      axis.text = element_text(size = 11, family = "Helvetica"),
      axis.ticks = element_blank(),
      panel.grid.major = element_line(color = "gray90", linewidth = 0.3),
      panel.grid.minor = element_blank(),
      plot.margin = unit(c(0.3, 0.3, 0.3, 0.3), "cm"),
      plot.subtitle = element_text(size = 10, hjust = 0.5, family = "Helvetica"),
      aspect.ratio = 1
    ) +
    labs(subtitle = subtitle_text)
  
  return(p)
}

